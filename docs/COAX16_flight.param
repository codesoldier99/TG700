# ============================================================================
# TG700 COAX16 标准飞行参数文件 (16电机全配置)
# 适用机型: TG700 全16电机同轴复合翼构型
# 基于: TG700_takeoff_v2_lightload.param
# 日期: 2026-05-02
#
# 与 X8 模式的切换方法:
#   加载本文件 -> Write Params -> 重启飞控 -> 重新校准
#   (外排8个电机上电，切回 Q_FRAME_TYPE=0 即激活16电机混控)
# ============================================================================


# ============================================================================
# 帧型配置 (CRITICAL)
# ============================================================================
Q_FRAME_CLASS,18
Q_FRAME_TYPE,0


# ============================================================================
# CAN总线 ESC 配置 (16电机全激活)
# CAN1: bits 4-11 = 0x0FF0 = 4080 (SERVO5-12, 8个右侧电机)
# CAN2: bits 12-19 = 0xFF000 = 1044480 (SERVO13-20, 8个左侧电机)
# ============================================================================
CAN_D1_UC_ESC_BM,4080
CAN_D1_UC_ESC_OF,4
CAN_D1_UC_NODE,10

CAN_D2_UC_ESC_BM,1044480
CAN_D2_UC_ESC_OF,12
CAN_D2_UC_NODE,11


# ============================================================================
# SERVO 通道映射 (16电机全配置)
#
# CAN1 右侧 (SERVO5-12 = ch4-11 = ESC idx 0-7):
#   SERVO5 -> ch4 -> CAN1 ESC0 -> P1前右外上桨(CW)   Motor1
#   SERVO6 -> ch5 -> CAN1 ESC1 -> P1前右外下桨(CCW)  Motor2
#   SERVO7 -> ch6 -> CAN1 ESC2 -> P2前右内上桨(CW)   Motor3
#   SERVO8 -> ch7 -> CAN1 ESC3 -> P2前右内下桨(CCW)  Motor4
#   SERVO9 -> ch8 -> CAN1 ESC4 -> P5后右外上桨(CW)   Motor9
#   SERVO10-> ch9 -> CAN1 ESC5 -> P5后右外下桨(CCW)  Motor10
#   SERVO11->ch10 -> CAN1 ESC6 -> P6后右内上桨(CW)   Motor11
#   SERVO12->ch11 -> CAN1 ESC7 -> P6后右内下桨(CCW)  Motor12
#
# CAN2 左侧 (SERVO13-20 = ch12-19 = ESC idx 0-7):
#   SERVO13->ch12 -> CAN2 ESC0 -> P3前左内上桨(CW)   Motor5
#   SERVO14->ch13 -> CAN2 ESC1 -> P3前左内下桨(CCW)  Motor6
#   SERVO15->ch14 -> CAN2 ESC2 -> P4前左外上桨(CW)   Motor7
#   SERVO16->ch15 -> CAN2 ESC3 -> P4前左外下桨(CCW)  Motor8
#   SERVO17->ch16 -> CAN2 ESC4 -> P7后左内上桨(CW)   Motor13
#   SERVO18->ch17 -> CAN2 ESC5 -> P7后左内下桨(CCW)  Motor14
#   SERVO19->ch18 -> CAN2 ESC6 -> P8后左外上桨(CW)   Motor15
#   SERVO20->ch19 -> CAN2 ESC7 -> P8后左外下桨(CCW)  Motor16
# ============================================================================

# --- CAN1 右侧 ---
SERVO5_FUNCTION,33
SERVO6_FUNCTION,34
SERVO7_FUNCTION,35
SERVO8_FUNCTION,36
SERVO9_FUNCTION,82
SERVO10_FUNCTION,83
SERVO11_FUNCTION,84
SERVO12_FUNCTION,85

# --- CAN2 左侧 ---
SERVO13_FUNCTION,37
SERVO14_FUNCTION,38
SERVO15_FUNCTION,39
SERVO16_FUNCTION,40
SERVO17_FUNCTION,160
SERVO18_FUNCTION,161
SERVO19_FUNCTION,162
SERVO20_FUNCTION,163


# ============================================================================
# 飞行模式
# ============================================================================
INITIAL_MODE,17
FLTMODE3,18


# ============================================================================
# 推力与油门参数 (200kg 轻载版本)
# 全16电机，200kg 测试质量下悬停油门约 0.25
# ============================================================================
Q_M_THST_HOVER,0.25
Q_M_HOVER_LEARN,0
Q_M_SPIN_MAX,0.40
Q_M_SPIN_MIN,0.10
Q_M_SPIN_ARM,0.05
Q_ANGLE_MAX,1000
THR_MAX,35


# ============================================================================
# PID 增益 (COAX16, 200kg轻载)
# 全16电机力矩臂: 外排Y=±3.4m, 内排Y=±1.6m
# ============================================================================
Q_A_RAT_RLL_P,0.10
Q_A_RAT_RLL_I,0.10
Q_A_RAT_RLL_D,0.003

Q_A_RAT_PIT_P,0.10
Q_A_RAT_PIT_I,0.10
Q_A_RAT_PIT_D,0.003

Q_A_RAT_YAW_P,0.30
Q_A_RAT_YAW_I,0.03

Q_A_ANG_RLL_P,2.5
Q_A_ANG_PIT_P,2.5
Q_A_ANG_YAW_P,2.0

Q_A_RAT_RLL_IMAX,0.3
Q_A_RAT_PIT_IMAX,0.3
Q_A_RAT_YAW_IMAX,0.3


# ============================================================================
# 速度/加速度限制
# ============================================================================
Q_PILOT_SPD_UP,0.5
Q_PILOT_SPD_DN,0.5
Q_PILOT_ACCEL_Z,0.5


# ============================================================================
# 电池监控 (ESC遥测, 全16个ESC)
# ============================================================================
BATT_MONITOR,9
BATT_ESC_MASK,0
BATT_CAPACITY,60000
BATT_LOW_VOLT,720
BATT_CRT_VOLT,680
BATT_LOW_TIMER,5
BATT_FS_LOW_ACT,1
BATT_FS_CRT_ACT,1
BATT_FS_VOLTSRC,0


# ============================================================================
# IMU / AHRS
# ============================================================================
INS_USE2,0
EK3_IMU_MASK,1
AHRS_EKF_TYPE,0
GPS1_TYPE,0
COMPASS_USE,0
COMPASS_USE2,0
COMPASS_USE3,0


# ============================================================================
# 解锁检查、RC、AHRS
# ============================================================================
ARMING_CHECK,82
RC1_DZ,50
RC2_DZ,50
RC4_DZ,50
AHRS_TRIM_X,0
AHRS_TRIM_Y,0


# ============================================================================
# 故障安全 & 降落
# ============================================================================
THR_FAILSAFE,0
FS_GCS_ENABL,0
Q_LAND_FINAL_ALT,2
Q_LAND_FINAL_SPD,0.2
