# ============================================================================
# TG700 同轴X8 飞行参数文件
# 适用机型: TG700 去掉外排8个电机后的8电机同轴X8构型
# 基于: TG700_takeoff_v2_lightload.param
# 日期: 2026-05-02
#
# 与 COAX16 的关键差异:
#   - 仅保留内排4个吊舱 (Y=±1.6m), 共8个电机
#   - Q_FRAME_TYPE 由 0 改为 1 (激活X8混控)
#   - CAN1/CAN2 各仅挂接4个ESC (ESC_BM从8位减为4位)
#   - 推力减半 -> 悬停油门翻倍 (Q_M_THST_HOVER 约从0.25升到0.50)
#   - 转动惯量略有变化 -> PID需重新整定
# ============================================================================


# ============================================================================
# 帧型配置 (CRITICAL - 必须与代码匹配)
# ============================================================================
# Q_FRAME_CLASS=18 (TG700自定义机架)
# Q_FRAME_TYPE=1   (激活 setup_motors_tg700_x8, COAX8)
Q_FRAME_CLASS,18
Q_FRAME_TYPE,1


# ============================================================================
# CAN总线 ESC 配置
# ============================================================================
# CAN1: 右侧内排 SERVO5-8 (ch4-7), ESC_BM = bits4-7 = 0x00F0 = 240
CAN_D1_UC_ESC_BM,240
CAN_D1_UC_ESC_OF,4
CAN_D1_UC_NODE,10

# CAN2: 左侧内排 SERVO9-12 (ch8-11), ESC_BM = bits8-11 = 0x0F00 = 3840
CAN_D2_UC_ESC_BM,3840
CAN_D2_UC_ESC_OF,8
CAN_D2_UC_NODE,11


# ============================================================================
# SERVO 通道映射 (仅 SERVO5-12, 对应8个电机)
# ============================================================================
# CAN1 右侧: SERVO5-8 → Motor1-4 (P2前右内 + P6后右内)
SERVO5_FUNCTION,33
SERVO6_FUNCTION,34
SERVO7_FUNCTION,35
SERVO8_FUNCTION,36

# CAN2 左侧: SERVO9-12 → Motor5-8 (P3前左内 + P7后左内)
SERVO9_FUNCTION,37
SERVO10_FUNCTION,38
SERVO11_FUNCTION,39
SERVO12_FUNCTION,40

# 停用原16电机中已拆除的8个外排通道
SERVO13_FUNCTION,0
SERVO14_FUNCTION,0
SERVO15_FUNCTION,0
SERVO16_FUNCTION,0
SERVO17_FUNCTION,0
SERVO18_FUNCTION,0
SERVO19_FUNCTION,0
SERVO20_FUNCTION,0


# ============================================================================
# 飞行模式
# ============================================================================
INITIAL_MODE,17
FLTMODE3,18


# ============================================================================
# 推力与油门参数
# ============================================================================
# 8电机总推力约为16电机的50% -> 悬停油门相应翻倍
# 如果飞机整机质量不变(因为只拆了电机+电调), 悬停油门从~0.25升至~0.50
# 实际值需在首次悬停后由Q_M_HOVER_LEARN=1自动学习
Q_M_THST_HOVER,0.50
Q_M_HOVER_LEARN,1

# 电机输出上限: X8推力充足, 保持合理余量
Q_M_SPIN_MAX,0.85
Q_M_SPIN_MIN,0.10
Q_M_SPIN_ARM,0.05

# 最大倾斜角 (10度保守值, 飞行正常后可提高到1500)
Q_ANGLE_MAX,1000

# 前飞油门限制
THR_MAX,65


# ============================================================================
# PID 增益 (X8初始值, 基于COAX16内排电机惯量估算)
#
# X8相比COAX16:
#   - Roll惯量: 仅内排, 力矩臂从0.4706×3.4=1.6m → 1.6m (相同)
#   - Pitch惯量: 前后臂 ±1.665m (相同)
#   - Yaw权威: 仅内排切向力, 比COAX16弱 (无外排贡献)
#   -> Roll/Pitch P增益与v2 lightload相似
#   -> Yaw P增益需适当提高以补偿权威降低
# ============================================================================
Q_A_RAT_RLL_P,0.10
Q_A_RAT_RLL_I,0.10
Q_A_RAT_RLL_D,0.003

Q_A_RAT_PIT_P,0.10
Q_A_RAT_PIT_I,0.10
Q_A_RAT_PIT_D,0.003

# X8偏航权威比COAX16弱(少4个外排吊舱), 适当提高P
Q_A_RAT_YAW_P,0.40
Q_A_RAT_YAW_I,0.04

# 角度环
Q_A_ANG_RLL_P,2.5
Q_A_ANG_PIT_P,2.5
Q_A_ANG_YAW_P,2.0

# I项饱和
Q_A_RAT_RLL_IMAX,0.3
Q_A_RAT_PIT_IMAX,0.3
Q_A_RAT_YAW_IMAX,0.3


# ============================================================================
# 速度/加速度限制
# ============================================================================
Q_PILOT_SPD_UP,0.5
Q_PILOT_SPD_DN,0.5
Q_PILOT_ACCEL_Z,0.5


# ============================================================================
# 电池监控 (ESC遥测)
# ============================================================================
# X8仅8个ESC, BATT_ESC_MASK=255 (bits0-7, 8个ESC)
BATT_MONITOR,9
BATT_ESC_MASK,255
BATT_CAPACITY,60000
BATT_LOW_VOLT,720
BATT_CRT_VOLT,680
BATT_LOW_TIMER,5
BATT_FS_LOW_ACT,1
BATT_FS_CRT_ACT,1
BATT_FS_VOLTSRC,0


# ============================================================================
# IMU / AHRS
# ============================================================================
INS_USE2,0
EK3_IMU_MASK,1
AHRS_EKF_TYPE,0
GPS1_TYPE,0
COMPASS_USE,0
COMPASS_USE2,0
COMPASS_USE3,0


# ============================================================================
# 解锁检查
# ============================================================================
ARMING_CHECK,82


# ============================================================================
# RC 死区
# ============================================================================
RC1_DZ,50
RC2_DZ,50
RC4_DZ,50


# ============================================================================
# AHRS 调平 (加载后须重新做水平校准)
# ============================================================================
AHRS_TRIM_X,0
AHRS_TRIM_Y,0


# ============================================================================
# 故障安全
# ============================================================================
THR_FAILSAFE,0
FS_GCS_ENABL,0


# ============================================================================
# 降落参数
# ============================================================================
Q_LAND_FINAL_ALT,2
Q_LAND_FINAL_SPD,0.2
