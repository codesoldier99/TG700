# ============================================================================
# TG700 同轴X8 飞行参数文件 (v2 - 无需重烧ESC)
# 适用机型: TG700 外排8个电机断电后的8电机同轴X8构型
# 基于: TG700_takeoff_v2_lightload.param
# 日期: 2026-05-02
#
# 核心设计:
#   ESC 硬件编号保持不变。通过调整 SERVO 通道函数分配，将 Motor1-8
#   的输出路由到保留电调（P2/P6/P3/P7）所对应的 CAN 命令槽位。
#
# DroneCAN ESC_BM 路由验证:
#   SRV_send_esc() 将 cmd.data[k] 对应 servo_channel = esc_offset + k
#   ESC 硬件监听的 index 即 k = servo_channel - ESC_OF
#
#   CAN1 (ESC_OF=4, 保留ESC idx 2,3,6,7):
#     Motor1 -> SERVO7 (ch6)  -> cmd.data[6-4=2] -> P2前右内上桨 (ESC2) ✓
#     Motor2 -> SERVO8 (ch7)  -> cmd.data[7-4=3] -> P2前右内下桨 (ESC3) ✓
#     Motor3 -> SERVO11(ch10) -> cmd.data[10-4=6] -> P6后右内上桨(ESC6) ✓
#     Motor4 -> SERVO12(ch11) -> cmd.data[11-4=7] -> P6后右内下桨(ESC7) ✓
#     断电ESC: cmd.data[0,1,4,5]=0, P1/P5无响应 (掉电) ✓
#
#   CAN2 (ESC_OF=12, 保留ESC idx 0,1,4,5):
#     Motor5 -> SERVO13(ch12) -> cmd.data[12-12=0] -> P3前左内上桨(ESC0) ✓
#     Motor6 -> SERVO14(ch13) -> cmd.data[13-12=1] -> P3前左内下桨(ESC1) ✓
#     Motor7 -> SERVO17(ch16) -> cmd.data[16-12=4] -> P7后左内上桨(ESC4) ✓
#     Motor8 -> SERVO18(ch17) -> cmd.data[17-12=5] -> P7后左内下桨(ESC5) ✓
#     断电ESC: cmd.data[2,3]=0, P4无响应; len=6, P8(idx6,7)不在数组内 ✓
# ============================================================================


# ============================================================================
# 帧型配置 (CRITICAL)
# ============================================================================
Q_FRAME_CLASS,18
Q_FRAME_TYPE,1


# ============================================================================
# CAN总线 ESC 配置
# ESC_OF 与 COAX16 相同，无需修改！仅更新 ESC_BM。
# ============================================================================
# CAN1: ESC_BM 精确对应保留的 servo ch 6,7,10,11
# bits 6,7,10,11 = 64+128+1024+2048 = 3264
CAN_D1_UC_ESC_BM,3264
CAN_D1_UC_ESC_OF,4
CAN_D1_UC_NODE,10

# CAN2: ESC_BM 精确对应保留的 servo ch 12,13,16,17
# bits 12,13,16,17 = 4096+8192+65536+131072 = 208896
CAN_D2_UC_ESC_BM,208896
CAN_D2_UC_ESC_OF,12
CAN_D2_UC_NODE,11


# ============================================================================
# SERVO 通道映射 (关键路由)
#
# 对照表: Motor -> SERVO -> ch -> ESC_idx (on bus) -> 物理吊舱
#   Motor1 -> SERVO7  -> ch6  -> CAN1 ESC2 -> P2前右内上桨(CW)
#   Motor2 -> SERVO8  -> ch7  -> CAN1 ESC3 -> P2前右内下桨(CCW)
#   Motor3 -> SERVO11 -> ch10 -> CAN1 ESC6 -> P6后右内上桨(CW)
#   Motor4 -> SERVO12 -> ch11 -> CAN1 ESC7 -> P6后右内下桨(CCW)
#   Motor5 -> SERVO13 -> ch12 -> CAN2 ESC0 -> P3前左内上桨(CW)
#   Motor6 -> SERVO14 -> ch13 -> CAN2 ESC1 -> P3前左内下桨(CCW)
#   Motor7 -> SERVO17 -> ch16 -> CAN2 ESC4 -> P7后左内上桨(CW)
#   Motor8 -> SERVO18 -> ch17 -> CAN2 ESC5 -> P7后左内下桨(CCW)
# ============================================================================

# --- 停用(断电)的外排吊舱通道 ---
SERVO5_FUNCTION,0
SERVO6_FUNCTION,0
SERVO9_FUNCTION,0
SERVO10_FUNCTION,0
SERVO15_FUNCTION,0
SERVO16_FUNCTION,0
SERVO19_FUNCTION,0
SERVO20_FUNCTION,0

# --- CAN1 右侧内排 (P2前右内 + P6后右内) ---
SERVO7_FUNCTION,33
SERVO8_FUNCTION,34
SERVO11_FUNCTION,35
SERVO12_FUNCTION,36

# --- CAN2 左侧内排 (P3前左内 + P7后左内) ---
SERVO13_FUNCTION,37
SERVO14_FUNCTION,38
SERVO17_FUNCTION,39
SERVO18_FUNCTION,40


# ============================================================================
# 飞行模式
# ============================================================================
INITIAL_MODE,17
FLTMODE3,18


# ============================================================================
# 推力与油门参数
# X8 总推力约为 COAX16 的 50% (8个电机 vs 16个电机)
# 若飞机质量不变，悬停油门从~0.25升到~0.50
# ============================================================================
Q_M_THST_HOVER,0.50
Q_M_HOVER_LEARN,1
Q_M_SPIN_MAX,0.85
Q_M_SPIN_MIN,0.10
Q_M_SPIN_ARM,0.05
Q_ANGLE_MAX,1000
THR_MAX,65


# ============================================================================
# PID 增益
# X8力臂 (Y=±1.6m) 与COAX16内排相同，Roll/Pitch增益参考v2 lightload
# X8偏航权威弱于COAX16 (少4个外排吊舱)，Yaw_P适当提高
# ============================================================================
Q_A_RAT_RLL_P,0.10
Q_A_RAT_RLL_I,0.10
Q_A_RAT_RLL_D,0.003

Q_A_RAT_PIT_P,0.10
Q_A_RAT_PIT_I,0.10
Q_A_RAT_PIT_D,0.003

Q_A_RAT_YAW_P,0.40
Q_A_RAT_YAW_I,0.04

Q_A_ANG_RLL_P,2.5
Q_A_ANG_PIT_P,2.5
Q_A_ANG_YAW_P,2.0

Q_A_RAT_RLL_IMAX,0.3
Q_A_RAT_PIT_IMAX,0.3
Q_A_RAT_YAW_IMAX,0.3


# ============================================================================
# 速度/加速度限制
# ============================================================================
Q_PILOT_SPD_UP,0.5
Q_PILOT_SPD_DN,0.5
Q_PILOT_ACCEL_Z,0.5


# ============================================================================
# 电池监控 (ESC遥测)
# BATT_ESC_MASK=0: 自动统计所有上报的ESC (断电的8个不上报，自动排除)
# ============================================================================
BATT_MONITOR,9
BATT_ESC_MASK,0
BATT_CAPACITY,60000
BATT_LOW_VOLT,720
BATT_CRT_VOLT,680
BATT_LOW_TIMER,5
BATT_FS_LOW_ACT,1
BATT_FS_CRT_ACT,1
BATT_FS_VOLTSRC,0


# ============================================================================
# IMU / AHRS
# ============================================================================
INS_USE2,0
EK3_IMU_MASK,1
AHRS_EKF_TYPE,0
GPS1_TYPE,0
COMPASS_USE,0
COMPASS_USE2,0
COMPASS_USE3,0


# ============================================================================
# 解锁检查、RC、AHRS
# ============================================================================
ARMING_CHECK,82
RC1_DZ,50
RC2_DZ,50
RC4_DZ,50
AHRS_TRIM_X,0
AHRS_TRIM_Y,0


# ============================================================================
# 故障安全 & 降落
# ============================================================================
THR_FAILSAFE,0
FS_GCS_ENABL,0
Q_LAND_FINAL_ALT,2
Q_LAND_FINAL_SPD,0.2
